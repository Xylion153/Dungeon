[gd_resource type="Resource" script_class="ClassData" load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/data/class_data.gd" id="1_cls"]
[ext_resource type="Script" path="res://scripts/data/stat_modifier_data.gd" id="2_mod"]
[ext_resource type="Script" path="res://scripts/data/weapon_data.gd" id="3_wpntype"]
[ext_resource type="Script" path="res://scripts/data/skill_data.gd" id="4_skltype"]
[ext_resource type="Resource" path="res://data/weapons/sword.tres" id="5_sword"]
[ext_resource type="Resource" path="res://data/weapons/spear.tres" id="6_spear"]
[ext_resource type="Resource" path="res://data/weapons/gun.tres" id="7_gun"]
[ext_resource type="Resource" path="res://data/weapons/wand.tres" id="8_wand"]
[ext_resource type="Resource" path="res://data/skills/frost_nova.tres" id="9_frostnova"]

[sub_resource type="Resource" id="Resource_mod1"]
script = ExtResource("2_mod")
stat_name = "max_health"
flat_bonus = 0.0
percent_bonus = 0.15

[sub_resource type="Resource" id="Resource_mod2"]
script = ExtResource("2_mod")
stat_name = "move_speed"
flat_bonus = 0.0
percent_bonus = 0.1

[resource]
script = ExtResource("1_cls")
id = "priest"
display_name = "Priest"
description = "A nimble support who leans on positioning to survive."
passive_description = "+15% max health, +10% move speed"
stat_modifiers = Array[ExtResource("2_mod")]([SubResource("Resource_mod1"), SubResource("Resource_mod2")])
allowed_weapons = Array[ExtResource("3_wpntype")]([ExtResource("5_sword"), ExtResource("6_spear"), ExtResource("7_gun"), ExtResource("8_wand")])
starter_skills = Array[ExtResource("4_skltype")]([ExtResource("9_frostnova")])
base_class_id = ""
